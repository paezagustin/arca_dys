[Unit]
Description=Local administrator configured deployment failure notification

[Service]
Type=oneshot
User=root
UMask=0077
# Instalar este hook local con el canal ya usado por el negocio (sin claves en Git).
ExecStart=/usr/local/sbin/arca-dys-deploy-notify
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
