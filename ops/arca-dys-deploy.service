[Unit]
Description=ARCA DYS validated image deployment (outbound pull)
RequiresMountsFor=/mnt/datos/docker/arca_dys
After=docker.service network-online.target
Wants=network-online.target
OnFailure=arca-dys-deploy-notify.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/arca-dys-deploy/deploy_agent.py
TimeoutStartSec=20min
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/mnt/datos/docker/arca_dys
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
