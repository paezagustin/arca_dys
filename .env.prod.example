# Copiar a .env.prod exclusivamente en la Raspberry; nunca usarlo en tests.
ENV=production
INTEGRATIONS_MODE=production
ALLOW_LIVE_OPERATIONS=false
POSTGRES_PASSWORD=REEMPLAZAR
# Codificar caracteres reservados de la contraseña en esta URL.
DATABASE_URL=postgresql://arca_user:REEMPLAZAR@postgres:5432/arca_dys
POSTGRES_DATA_PATH=/mnt/datos/docker/arca_dys/postgres
BACKUP_PATH=/mnt/datos/docker/arca_dys/backups
ARCA_CERTIFICATES_PATH=/mnt/datos/docker/arca_dys/certificates
ARCA_CRT_PATH=/run/arca/certificado.crt
ARCA_KEY_PATH=/run/arca/privada.key
ARCA_CUIT=
ARCA_ACCESS_TOKEN=
ARCA_PTO_VTA=10
MP_ACCESS_TOKEN=
MP_COLLECTOR_ID=
MP_WEBHOOK_SECRET=
# Solo si el producto QR/IPN no firma: secreto aleatorio de al menos 32 caracteres.
MP_LEGACY_WEBHOOK_TOKEN=
NGROK_AUTHTOKEN=
# Solo con docker-compose.ngrok.yml: conservar la URL HTTPS actual, sin path.
NGROK_URL=
APP_LOGS_PATH=/mnt/datos/docker/arca_dys/logs
LIMITE_FACTURACION_MINIMA=1000
LIMITE_FACTURACION_MAXIMA=2000000

# Excepcion HTTP privada: habilitar solo con hosts y redes de clientes explicitos.
# Sin ambas listas, las cookies de produccion siguen exigiendo HTTPS.
ARCA_HTTP_COOKIE_HOSTS=
ARCA_HTTP_COOKIE_CLIENT_NETWORKS=
